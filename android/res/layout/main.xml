<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f172a">

    <!-- Tab strip -->
    <HorizontalScrollView
        android:id="@+id/tab_scroll"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#020617"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/tab_strip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1e293b"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">
        <Button android:id="@+id/btn_back" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹" />
        <Button android:id="@+id/btn_fwd" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" />
        <Button android:id="@+id/btn_reload" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↻" />
        <EditText
            android:id="@+id/url"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:background="#0b1220"
            android:textColor="#e2e8f0"
            android:textColorHint="#64748b"
            android:hint="@string/url_hint"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:singleLine="true"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textSize="14sp"
            android:selectAllOnFocus="true" />
        <Button android:id="@+id/btn_newtab" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" />
        <Button android:id="@+id/btn_ua" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🖥" />
        <Button android:id="@+id/btn_dock" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⇲" />
        <Button android:id="@+id/btn_devtools" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙ DevTools" android:textColor="#38bdf8" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:progressTint="#38bdf8"
        android:progress="0"
        android:visibility="gone" />

    <!-- Page + DevTools split. Orientation switched at runtime for dock right/bottom. -->
    <LinearLayout
        android:id="@+id/split"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <View
            android:id="@+id/divider"
            android:layout_width="8dp"
            android:layout_height="match_parent"
            android:background="#334155"
            android:visibility="gone" />
        <FrameLayout
            android:id="@+id/devtools_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
