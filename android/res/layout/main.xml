<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f172a">

    <!-- Tab strip -->
    <HorizontalScrollView
        android:id="@+id/tab_scroll"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#020617"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/tab_strip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1e293b"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">
        <Button android:id="@+id/btn_back" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹" />
        <Button android:id="@+id/btn_fwd" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" />
        <Button android:id="@+id/btn_reload" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↻" />
        <EditText
            android:id="@+id/url"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:background="#0b1220"
            android:textColor="#e2e8f0"
            android:textColorHint="#64748b"
            android:hint="@string/url_hint"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:singleLine="true"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textSize="14sp"
            android:selectAllOnFocus="true" />
        <Button android:id="@+id/btn_newtab" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" />
        <Button android:id="@+id/btn_ua" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🖥" />
        <Button android:id="@+id/btn_dock" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⇲" />
        <Button android:id="@+id/btn_ruby" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rb" android:textColor="#f472b6" />
        <Button android:id="@+id/btn_devtools" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙ DevTools" android:textColor="#38bdf8" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:progressTint="#38bdf8"
        android:progress="0"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0b1220"
        android:textColor="#94a3b8"
        android:textSize="12sp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- Page + DevTools split. Orientation switched at runtime for dock right/bottom. -->
    <LinearLayout
        android:id="@+id/split"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <View
            android:id="@+id/divider"
            android:layout_width="8dp"
            android:layout_height="match_parent"
            android:background="#334155"
            android:visibility="gone" />
        <FrameLayout
            android:id="@+id/devtools_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Ruby log + console pane (toggle with the Rb button). Our debugging window without logcat. -->
    <LinearLayout
        android:id="@+id/ruby_pane"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:background="#020617"
        android:visibility="gone">
        <ScrollView
            android:id="@+id/ruby_log_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:id="@+id/ruby_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#a5b4fc"
                android:textSize="11sp"
                android:typeface="monospace"
                android:padding="8dp"
                android:textIsSelectable="true" />
        </ScrollView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#0b1220">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="rb›" android:textColor="#f472b6" android:paddingLeft="8dp" android:typeface="monospace" />
            <EditText
                android:id="@+id/ruby_input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@null"
                android:textColor="#e2e8f0"
                android:textSize="13sp"
                android:typeface="monospace"
                android:hint="Ruby expression, e.g. Inspect.version"
                android:textColorHint="#475569"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:singleLine="true"
                android:paddingLeft="6dp" />
            <Button android:id="@+id/btn_ruby_clear" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="clear" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
