<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f172a">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Reserves space for the chrome WebView, which floats above (see bottom of file) -->
    <View
        android:id="@+id/chrome_space"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#020617" />

    <!-- Page + DevTools split. Orientation switched at runtime for dock right/bottom. -->
    <LinearLayout
        android:id="@+id/split"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <View
            android:id="@+id/divider"
            android:layout_width="8dp"
            android:layout_height="match_parent"
            android:background="#334155"
            android:visibility="gone" />
        <FrameLayout
            android:id="@+id/devtools_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Ruby log + console pane (toggle with the Rb button). Our debugging window without logcat. -->
    <LinearLayout
        android:id="@+id/ruby_pane"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:background="#020617"
        android:visibility="gone">
        <ScrollView
            android:id="@+id/ruby_log_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:id="@+id/ruby_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#a5b4fc"
                android:textSize="11sp"
                android:typeface="monospace"
                android:padding="8dp"
                android:textIsSelectable="true" />
        </ScrollView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#0b1220">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="rb›" android:textColor="#f472b6" android:paddingLeft="8dp" android:typeface="monospace" />
            <EditText
                android:id="@+id/ruby_input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@null"
                android:textColor="#e2e8f0"
                android:textSize="13sp"
                android:typeface="monospace"
                android:hint="Ruby expression, e.g. Inspect.version"
                android:textColorHint="#475569"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:singleLine="true"
                android:paddingLeft="6dp" />
            <Button android:id="@+id/btn_ruby_clear" style="@style/ToolBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="clear" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <!-- Browser chrome: tabs, toolbar, bookmarks, menus, pages — HTML rendered from Ruby (Opal), see ui/.
         Transparent; grows to full height while a dropdown or page is open. -->
    <WebView
        android:id="@+id/chrome"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="top" />

    <!-- Diagnostics line: drawn above the chrome layer so an expanded chrome cannot hide it -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0b1220"
        android:textColor="#94a3b8"
        android:textSize="12sp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_gravity="bottom"
        android:visibility="gone" />
</FrameLayout>
