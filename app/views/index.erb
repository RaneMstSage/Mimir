<section id="notready" class="card warn" hidden>
  <h2>Not connected yet</h2>
  <p id="notready-msg">Checking…</p>
  <div class="row">
    <button id="btn-auto" class="primary">Connect now</button>
    <a class="btn" href="/setup">Open setup</a>
  </div>
  <pre id="log" class="log" hidden></pre>
</section>

<section id="ready" hidden>
  <div class="row between">
    <h2>Chrome tabs <small id="chrome-ver"></small></h2>
    <form id="newtab" class="row">
      <input id="newurl" type="url" placeholder="https://example.com" inputmode="url">
      <button class="primary">New tab</button>
    </form>
  </div>
  <p class="hint">Tap <b>Inspect</b> to open DevTools for that tab in a new window. Use split-screen (or DeX) to see the page and DevTools side by side. In DevTools, the top-left cursor icon is tap-to-inspect.</p>
  <ul id="tabs" class="tabs"></ul>

  <details id="others">
    <summary>Other browsers &amp; WebViews</summary>
    <ul id="browsers" class="tabs"></ul>
  </details>
</section>
